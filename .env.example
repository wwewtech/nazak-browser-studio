# Copy to .env next to docker-compose.yml and set a long random secret.
# The container binds 0.0.0.0 internally, so the API refuses to start without it.
# Clients (CLI / Playwright scripts) send it as the X-API-Key header.
NAZAK_API_TOKEN=change-me-to-a-long-random-secret

# Profile storage backend: json (default, current behaviour) or sqlite (opt-in).
# sqlite keeps profiles.db (WAL) next to profiles.json, migrates all valid rows
# from JSON once (keeping profiles.pre-sqlite.<ts>.bak, never deleted), and uses
# single-row upserts instead of rewriting the whole file on every change.
# Rollback: unset (or json) — the JSON file is used again on next start.
# See docs/API_REFERENCE.md § Profile Storage Backends and CHANGELOG (P0 section)
# for the deferred default-switch gates.
NAZAK_PROFILE_STORE=json
